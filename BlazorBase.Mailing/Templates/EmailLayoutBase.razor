@namespace BlazorBase.Mailing.Templates

<!DOCTYPE html>
<html lang="@Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Subject</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: @BackgroundColor;
            font-family: @BodyFontFamily, Arial, sans-serif;
            color: @TextColor;
            -webkit-font-smoothing: antialiased;
        }
        .preheader {
            display: none !important;
            visibility: hidden;
            mso-hide: all;
            font-size: 1px;
            line-height: 1px;
            max-height: 0;
            max-width: 0;
            opacity: 0;
            overflow: hidden;
        }
        .wrapper {
            width: 100%;
            background-color: @BackgroundColor;
            padding: 24px 12px;
        }
        .container {
            max-width: 560px;
            margin: 0 auto;
            background-color: @ContainerColor;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        }
        .header {
            background-color: @HeaderColor;
            color: @HeaderTextColor;
            padding: 24px 32px;
            font-family: @DisplayFontFamily, Arial, sans-serif;
            font-weight: 700;
            font-size: 20px;
        }
        .body {
            padding: 32px;
            font-size: 15px;
            line-height: 1.6;
        }
        .body h1 {
            font-family: @DisplayFontFamily, Arial, sans-serif;
            font-size: 22px;
            margin: 0 0 16px 0;
            color: @TextColor;
        }
        .body p {
            margin: 0 0 16px 0;
        }
        .footer {
            padding: 16px 32px 24px 32px;
            font-size: 12px;
            color: @MutedTextColor;
            border-top: 1px solid @BorderColor;
            text-align: center;
        }
        .button {
            display: inline-block;
            padding: 12px 24px;
            background-color: @AccentColor;
            color: @AccentTextColor !important;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            font-family: @DisplayFontFamily, Arial, sans-serif;
        }
    </style>
</head>
<body>
    @if (!string.IsNullOrWhiteSpace(PreheaderText))
    {
        <span class="preheader">@PreheaderText</span>
    }
    <div class="wrapper">
        <div class="container">
            <div class="header">
                @if (Header is null)
                {
                    @BrandName
                }
                else
                {
                    @Header
                }
            </div>
            <div class="body">
                @Body
            </div>
            <div class="footer">
                @if (Footer is null)
                {
                    <span>&copy; @DateTime.UtcNow.Year @BrandName</span>
                }
                else
                {
                    @Footer
                }
            </div>
        </div>
    </div>
</body>
</html>
