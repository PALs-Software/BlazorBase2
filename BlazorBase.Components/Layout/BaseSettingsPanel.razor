@namespace BlazorBase.Components.Layout
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular

@if (IsOpen)
{
    <div class="base-settings-overlay" @onclick="CloseAsync"></div>
    <aside id="@PanelId"
           class="base-settings-panel"
           role="dialog"
           aria-modal="true"
           aria-labelledby="@TitleId"
           tabindex="-1"
           @ref="PanelElement"
           @onkeydown="OnKeyDownAsync">
        <div class="base-settings-header">
            <h2 id="@TitleId" class="base-settings-title">@Localizer["Title"]</h2>
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          Class="base-settings-close"
                          IconOnly="true"
                          IconStart="@(new Size20.Dismiss())"
                          Title="@Localizer["Close"]"
                          OnClick="CloseAsync" />
        </div>
        <div class="base-settings-body">
            @if (LanguageChoices.Count > 0)
            {
                <section class="base-settings-section">
                    <FluentRadioGroup TValue="string"
                                      Class="base-settings-radio-group"
                                      Label="@Localizer["Language"]"
                                      Orientation="Orientation.Vertical"
                                      Value="@LanguageService.CurrentLanguage"
                                      ValueChanged="SelectLanguageAsync">
                        @foreach (var option in LanguageChoices)
                        {
                            <FluentRadio TValue="string" Value="@option.Key" Label="@option.Value" Class="base-touch-target base-choice" />
                        }
                    </FluentRadioGroup>
                </section>
            }
            <section class="base-settings-section">
                <FluentRadioGroup TValue="string"
                                  Class="base-settings-radio-group"
                                  Label="@Localizer["Theme"]"
                                  Orientation="Orientation.Vertical"
                                  Value="@ThemeService.CurrentTheme.ToString()"
                                  ValueChanged="SelectThemeAsync">
                    <FluentRadio TValue="string" Value="@nameof(ThemePreference.System)" Label="@Localizer["System"]" Class="base-touch-target base-choice" />
                    <FluentRadio TValue="string" Value="@nameof(ThemePreference.Light)" Label="@Localizer["Light"]" Class="base-touch-target base-choice" />
                    <FluentRadio TValue="string" Value="@nameof(ThemePreference.Dark)" Label="@Localizer["Dark"]" Class="base-touch-target base-choice" />
                </FluentRadioGroup>
            </section>
            @ChildContent?.Invoke(Context)
        </div>
    </aside>
}
