@inherits BaseDialogInstance<DateInputDialogContent>

<BaseDialogBody CommitPendingEditOnEscape="false">
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
            <FluentText As="TextTag.Paragraph">@Content.Message</FluentText>
            <FluentDatePicker TValue="DateTime?" Value="@SelectedDate" ValueChanged="@OnDateChanged" />
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      Disabled="@(SelectedDate is null)"
                      OnClick="@ConfirmDateAsync">
            @ConfirmText
        </FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@CancelAsync">
            @CancelText
        </FluentButton>
    </ActionTemplate>
</BaseDialogBody>
