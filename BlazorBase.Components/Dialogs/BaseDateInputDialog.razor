@implements IDialogContentComponent<DateInputDialogContent>

<FluentDialogBody>
    <DialogBehavior CommitPendingEditOnEscape="false" DismissOnEscape="true">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Typo="Typography.Body">@Content.Message</FluentLabel>

            <FluentDatePicker Value="@SelectedDate" ValueChanged="@OnDateChanged" />

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                <FluentButton Appearance="Appearance.Accent"
                             Disabled="@(SelectedDate is null)"
                             OnClick="@ConfirmAsync">
                    @ConfirmText
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="@CancelAsync">
                    @CancelText
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </DialogBehavior>
</FluentDialogBody>
