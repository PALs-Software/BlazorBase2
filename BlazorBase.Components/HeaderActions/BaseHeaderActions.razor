@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular

@if (Inline.Count > 0 || Overflow.Count > 0)
{
    <div class="base-header-actions" role="group" aria-label="@Localizer["Actions"]" @onkeydown="OnKeyDown">
        @foreach (var item in Inline)
        {
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          Class="base-header-action base-header-control"
                          IconOnly="true"
                          IconStart="@item.Icon"
                          Title="@item.Title"
                          aria-haspopup="@item.PopupKind"
                          aria-pressed="@PressedValue(item)"
                          data-action-id="@item.Id"
                          OnClick="() => ActivateAsync(item)" />
        }
        @if (Overflow.Count > 0)
        {
            <span class="base-header-actions-more">
                <FluentButton Appearance="ButtonAppearance.Transparent"
                              Class="base-header-action base-header-actions-toggle base-header-control"
                              IconOnly="true"
                              IconStart="@(new Size20.MoreHorizontal())"
                              Title="@Localizer["More"]"
                              aria-haspopup="menu"
                              aria-expanded="@(IsMenuOpen ? "true" : "false")"
                              aria-controls="@MenuId"
                              OnClick="ToggleMenu" />
                @if (IsMenuOpen)
                {
                    <div class="base-header-actions-backdrop" @onclick="CloseMenu"></div>
                    <div id="@MenuId" class="base-header-actions-menu" role="menu" aria-label="@Localizer["More"]">
                        @foreach (var item in Overflow)
                        {
                            <button type="button"
                                    role="menuitem"
                                    class="base-header-actions-menu-item"
                                    data-action-id="@item.Id"
                                    aria-haspopup="@item.PopupKind"
                                    @onclick="() => ActivateAsync(item)">
                                <FluentIcon Value="@item.Icon" Color="Color.Custom" CustomColor="currentColor" />
                                <span>@item.Title</span>
                            </button>
                        }
                    </div>
                }
            </span>
        }
    </div>
}
