<div>
<FluentText As="TextTag.H1" Size="TextSize.Size800">@Localizer["Title"]</FluentText>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-5)" Class="settings-form">

    <FluentSelect TOption="KeyValuePair<string, string>" TValue="string" Label="@Localizer["Theme"]" Value="@SelectedTheme" ValueChanged="@(v => SelectedTheme = v ?? SelectedTheme)"
                  Items="@ThemeDisplayOptions" OptionValue="@(o => o.Key)" OptionText="@(o => o.Value)"
                  Class="settings-select" />

    <FluentSelect TOption="KeyValuePair<string, string>" TValue="string" Label="@Localizer["Language"]" Value="@SelectedLanguage" ValueChanged="@(v => SelectedLanguage = v ?? SelectedLanguage)"
                  Items="@LanguageDisplayOptions" OptionValue="@(o => o.Key)" OptionText="@(o => o.Value)"
                  Class="settings-select" />

    @if (ShowServerUrl)
    {
        <FluentTextInput Label="@Localizer["ServerUrl"]" @bind-Value="ServerUrl" Class="full-width" />
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="TestConnection"
                      Loading="@TestingConnection">
            @Localizer["TestConnection"]
        </FluentButton>
        @if (ConnectionTestResult is not null)
        {
            <FluentMessageBar Intent="@(ConnectionTestOk ? MessageBarIntent.Success : MessageBarIntent.Error)" AllowDismiss="false" role="@(ConnectionTestOk ? "status" : "alert")">
                @ConnectionTestResult
            </FluentMessageBar>
        }
    }

    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveSettings" Loading="@Saving">
        @Localizer["Save"]
    </FluentButton>

    @if (SaveMessage is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false" role="status">@SaveMessage</FluentMessageBar>
    }

</FluentStack>
</div>
