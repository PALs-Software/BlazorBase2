@using BlazorBase.Components.Dialogs
@inherits BaseDialogInstance<ResetPasswordModel>

<BaseDialogBody>
    <ChildContent>
        <FluentTextInput Label="@DialogLocalizer["NewPassword"]" @bind-Value="Content.NewPassword" Required="true"
                         TextInputType="TextInputType.Password" AutoComplete="new-password" Class="full-width" data-autofocus="true" />
    </ChildContent>
</BaseDialogBody>
