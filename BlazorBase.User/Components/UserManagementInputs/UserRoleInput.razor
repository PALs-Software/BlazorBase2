@using BlazorBase.CRUD.Components.CustomProperties
@implements IBaseCustomPropertyInput

<div class="user-role-input">
    <FluentSelect TOption="RoleOption"
                  TValue="string"
                  Items="@RoleOptions"
                  OptionValue="@(option => option?.Value)"
                  OptionText="@(option => option?.Text ?? string.Empty)"
                  Value="@(HasKnownRole ? RoleValue : string.Empty)"
                  ValueChanged="@OnRoleChanged"
                  Disabled="@(ReadOnly || !IsEditing)"
                  Label="@FieldLabel" />
</div>
