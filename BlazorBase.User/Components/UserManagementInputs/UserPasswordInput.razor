@using BlazorBase.CRUD.Components.CustomProperties
@implements IBaseCustomPropertyInput

<div class="user-password-input">
    <FluentTextInput @bind-Value="PasswordValue"
                     TextInputType="TextInputType.Password"
                     ReadOnly="@(ReadOnly || !IsEditing)"
                     Label="@FieldLabel"
                     Placeholder="@PlaceholderText"
                     AutoComplete="new-password" />
</div>
