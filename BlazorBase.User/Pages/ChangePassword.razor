@page "/account/password"
@attribute [Authorize]
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="change-password">
<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             Class="change-password-container">
    <FluentCard Class="change-password-card">
        <h2>@Localizer["PageTitle"]</h2>

        @if (IsCompleted)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false" role="status" Class="change-password-completed">
                @Localizer["Completed"]
            </FluentMessageBar>
        }
        else
        {
            <p>@Localizer["Description"]</p>

            <EditForm Model="RequestModel" OnSubmit="SubmitAsync" FormName="ChangePasswordForm">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="change-password-form">
                    <div class="change-password-field">
                        <FluentTextInput @bind-Value="RequestModel.CurrentPassword"
                                         Immediate="true"
                                         Label="@Localizer["CurrentPassword"]"
                                         TextInputType="@(ShowCurrentPassword ? TextInputType.Text : TextInputType.Password)"
                                         Required="true"
                                         AutoComplete="current-password"
                                         Class="change-password-full-width change-password-current">
                            <EndTemplate>
                                <FluentButton Type="ButtonType.Button"
                                              Appearance="ButtonAppearance.Transparent"
                                              Size="ButtonSize.Small"
                                              IconOnly="true"
                                              Class="change-password-toggle change-password-toggle-current"
                                              Title="@VisibilityLabel(ShowCurrentPassword)"
                                              aria-label="@VisibilityLabel(ShowCurrentPassword)"
                                              aria-pressed="@(ShowCurrentPassword ? "true" : "false")"
                                              OnClick="ToggleCurrentPassword"
                                              IconStart="@(ShowCurrentPassword ? new Size16.EyeOff() : new Size16.Eye())" />
                            </EndTemplate>
                        </FluentTextInput>
                        @if (!string.IsNullOrEmpty(CurrentPasswordError))
                        {
                            <div class="change-password-field-error change-password-current-error" role="alert">@CurrentPasswordError</div>
                        }
                    </div>

                    <div class="change-password-field">
                        <FluentTextInput @bind-Value="RequestModel.NewPassword"
                                         Immediate="true"
                                         Label="@Localizer["NewPassword"]"
                                         TextInputType="@(ShowNewPassword ? TextInputType.Text : TextInputType.Password)"
                                         Required="true"
                                         AutoComplete="new-password"
                                         Class="change-password-full-width change-password-new">
                            <EndTemplate>
                                <FluentButton Type="ButtonType.Button"
                                              Appearance="ButtonAppearance.Transparent"
                                              Size="ButtonSize.Small"
                                              IconOnly="true"
                                              Class="change-password-toggle change-password-toggle-new"
                                              Title="@VisibilityLabel(ShowNewPassword)"
                                              aria-label="@VisibilityLabel(ShowNewPassword)"
                                              aria-pressed="@(ShowNewPassword ? "true" : "false")"
                                              OnClick="ToggleNewPassword"
                                              IconStart="@(ShowNewPassword ? new Size16.EyeOff() : new Size16.Eye())" />
                            </EndTemplate>
                        </FluentTextInput>
                        @foreach (var newPasswordError in NewPasswordErrors)
                        {
                            <div class="change-password-field-error change-password-new-error" role="alert">@newPasswordError</div>
                        }
                    </div>

                    <div class="change-password-field">
                        <FluentTextInput @bind-Value="PasswordConfirmation"
                                         Immediate="true"
                                         Label="@Localizer["ConfirmPassword"]"
                                         TextInputType="@(ShowConfirmation ? TextInputType.Text : TextInputType.Password)"
                                         Required="true"
                                         AutoComplete="new-password"
                                         Class="change-password-full-width change-password-confirmation">
                            <EndTemplate>
                                <FluentButton Type="ButtonType.Button"
                                              Appearance="ButtonAppearance.Transparent"
                                              Size="ButtonSize.Small"
                                              IconOnly="true"
                                              Class="change-password-toggle change-password-toggle-confirmation"
                                              Title="@VisibilityLabel(ShowConfirmation)"
                                              aria-label="@VisibilityLabel(ShowConfirmation)"
                                              aria-pressed="@(ShowConfirmation ? "true" : "false")"
                                              OnClick="ToggleConfirmation"
                                              IconStart="@(ShowConfirmation ? new Size16.EyeOff() : new Size16.Eye())" />
                            </EndTemplate>
                        </FluentTextInput>
                        @if (!string.IsNullOrEmpty(ConfirmationError))
                        {
                            <div class="change-password-field-error change-password-confirmation-error" role="alert">@ConfirmationError</div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert" Class="change-password-error">
                            @ErrorMessage
                        </FluentMessageBar>
                    }

                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  Class="change-password-full-width">
                        @Localizer["Submit"]
                    </FluentButton>
                </FluentStack>
            </EditForm>
        }
    </FluentCard>
</FluentStack>
</div>
