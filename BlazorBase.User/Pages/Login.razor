@page "/login"
@attribute [AllowAnonymous]

<PageTitle>@(IsSetupMode ? Localizer["SetupPageTitle"] : Localizer["PageTitle"])</PageTitle>

<div>
<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             Class="login-container">
    <FluentCard Class="login-card">
        @if (IsLoading)
        {
            <FluentSpinner Size="SpinnerSize.Medium" />
        }
        else if (PendingTwoFactorToken is not null)
        {
            <h2>@Localizer["TwoFactorTitle"]</h2>
            <p>@Localizer["TwoFactorDescription"]</p>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="form-stack">
                <FluentTextInput @bind-Value="TwoFactorCode"
                                 Immediate="true"
                                 Label="@Localizer["TwoFactorCode"]"
                                 Required="true"
                                 AutoComplete="one-time-code"
                                 Class="full-width" />

                <FluentCheckbox @bind-Value="TwoFactorCodeIsRecoveryCode" Label="@Localizer["TwoFactorUseRecoveryCode"]" />

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert">
                        @ErrorMessage
                    </FluentMessageBar>
                }

                <FluentButton Appearance="ButtonAppearance.Primary"
                              Loading="IsSubmitting"
                              Class="full-width"
                              OnClick="HandleTwoFactorSubmit">
                    @Localizer["TwoFactorSubmit"]
                </FluentButton>
            </FluentStack>
        }
        else if (IsSetupMode)
        {
            <h2>@Localizer["Welcome"]</h2>
            <p>@Localizer["SetupDescription"]</p>

            <EditForm EditContext="SetupEditContext" OnValidSubmit="HandleSetup" FormName="SetupForm">
                <DataAnnotationsValidator />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="form-stack">
                    <FluentTextInput @bind-Value="SetupModel.DisplayName"
                                     @onkeydown="HandleSetupKeyDown"
                                     Immediate="true"
                                     Label="@Localizer["DisplayName"]"
                                     Required="true"
                                     AutoComplete="name"
                                     Class="full-width" />

                    <FluentTextInput @bind-Value="SetupModel.Email"
                                     @onkeydown="HandleSetupKeyDown"
                                     Immediate="true"
                                     Label="@Localizer["Email"]"
                                     TextInputType="TextInputType.Email"
                                     Required="true"
                                     AutoComplete="username"
                                     Class="full-width" />

                    <FluentTextInput @bind-Value="SetupModel.Password"
                                     @onkeydown="HandleSetupKeyDown"
                                     Immediate="true"
                                     Label="@Localizer["Password"]"
                                     TextInputType="TextInputType.Password"
                                     Required="true"
                                     AutoComplete="new-password"
                                     Class="full-width" />

                    <FluentTextInput @bind-Value="SetupPasswordConfirm"
                                     @onkeydown="HandleSetupKeyDown"
                                     Immediate="true"
                                     Label="@Localizer["ConfirmPassword"]"
                                     TextInputType="TextInputType.Password"
                                     Required="true"
                                     AutoComplete="new-password"
                                     Class="full-width" />

                    @if (CollectHouseholdName)
                    {
                        <FluentTextInput @bind-Value="SetupModel.HouseholdName"
                                         @onkeydown="HandleSetupKeyDown"
                                         Immediate="true"
                                         Label="@Localizer["HouseholdName"]"
                                         AutoComplete="off"
                                         Class="full-width" />
                    }

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert">
                            @ErrorMessage
                        </FluentMessageBar>
                    }

                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  Class="full-width">
                        @Localizer["CreateAdminAccount"]
                    </FluentButton>
                </FluentStack>
            </EditForm>
        }
        else
        {
            <h2>@Localizer["Login"]</h2>

            <EditForm EditContext="LoginEditContext" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="form-stack">
                    <FluentTextInput @bind-Value="LoginModel.Email"
                                     @onkeydown="HandleLoginKeyDown"
                                     Immediate="true"
                                     Label="@Localizer["Email"]"
                                     TextInputType="TextInputType.Email"
                                     Required="true"
                                     AutoComplete="username"
                                     Class="full-width" />

                    <FluentTextInput @bind-Value="LoginModel.Password"
                                     @onkeydown="HandleLoginKeyDown"
                                     Immediate="true"
                                     Label="@Localizer["Password"]"
                                     TextInputType="TextInputType.Password"
                                     Required="true"
                                     AutoComplete="current-password"
                                     Class="full-width" />

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert">
                            @ErrorMessage
                        </FluentMessageBar>
                    }

                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  Class="full-width">
                        @Localizer["Login"]
                    </FluentButton>
                </FluentStack>
            </EditForm>
        }
    </FluentCard>
</FluentStack>
</div>
