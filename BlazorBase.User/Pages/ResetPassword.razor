@page "/reset-password"
@attribute [AllowAnonymous]

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="reset-password">
<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             Class="reset-password-container">
    <FluentCard Class="reset-password-card">
        <h2>@Localizer["PageTitle"]</h2>

        @if (IsCompleted)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false" role="status" Class="reset-password-completed">
                @Localizer["Completed"]
            </FluentMessageBar>
        }
        else if (!HasLinkParameters)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false" role="alert" Class="reset-password-invalid-link">
                @Localizer["InvalidLink"]
            </FluentMessageBar>
        }
        else
        {
            <p>
                @Localizer["EmailLabel"]
                <strong class="reset-password-email">@RequestModel.Email</strong>
            </p>

            <EditForm EditContext="RequestEditContext" OnValidSubmit="SubmitAsync" FormName="ResetPasswordForm">
                <DataAnnotationsValidator />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="reset-password-form">
                    <FluentTextInput @bind-Value="RequestModel.NewPassword"
                                     Immediate="true"
                                     Label="@Localizer["NewPassword"]"
                                     TextInputType="TextInputType.Password"
                                     Required="true"
                                     AutoComplete="new-password"
                                     Class="reset-password-full-width" />

                    <FluentTextInput @bind-Value="PasswordConfirmation"
                                     Immediate="true"
                                     Label="@Localizer["ConfirmPassword"]"
                                     TextInputType="TextInputType.Password"
                                     Required="true"
                                     AutoComplete="new-password"
                                     Class="reset-password-full-width" />

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert" Class="reset-password-error">
                            @ErrorMessage
                        </FluentMessageBar>
                    }

                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  Class="reset-password-full-width">
                        @Localizer["Submit"]
                    </FluentButton>
                </FluentStack>
            </EditForm>
        }

        <a href="login" class="reset-password-login-link">@Localizer["BackToLogin"]</a>
    </FluentCard>
</FluentStack>
</div>
