@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="forgot-password">
<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             Class="forgot-password-container">
    <FluentCard Class="forgot-password-card">
        <h2>@Localizer["PageTitle"]</h2>

        @if (IsSent)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false" role="status" Class="forgot-password-sent">
                @Localizer["Sent"]
            </FluentMessageBar>
        }
        else
        {
            <p>@Localizer["Description"]</p>

            <EditForm EditContext="RequestEditContext" OnValidSubmit="SubmitAsync" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="forgot-password-form">
                    <FluentTextInput @bind-Value="RequestModel.Email"
                                     Immediate="true"
                                     Label="@Localizer["Email"]"
                                     TextInputType="TextInputType.Email"
                                     Required="true"
                                     AutoComplete="username"
                                     Class="forgot-password-full-width" />

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert">
                            @ErrorMessage
                        </FluentMessageBar>
                    }

                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  Class="forgot-password-full-width">
                        @Localizer["Submit"]
                    </FluentButton>
                </FluentStack>
            </EditForm>
        }

        <a href="login" class="forgot-password-login-link">@Localizer["BackToLogin"]</a>
    </FluentCard>
</FluentStack>
</div>
