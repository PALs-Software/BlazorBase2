@page "/setup-server"
@attribute [AllowAnonymous]

<PageTitle>Server Setup</PageTitle>

<div>
<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             Class="setup-container">
    <FluentCard Class="setup-card">
        <h2>Server Setup</h2>
        <p>Enter the URL of your server.</p>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-4)" Class="form-stack">
            <FluentTextInput @bind-Value="ServerUrl"
                             Label="Server URL"
                             Placeholder="https://your-server.example.com"
                             Required="true"
                             Class="full-width" />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false" role="alert">
                    @ErrorMessage
                </FluentMessageBar>
            }

            @if (IsSuccess)
            {
                <FluentMessageBar Intent="MessageBarIntent.Success" Title="Success" AllowDismiss="false" role="status">
                    Connection successful!
                </FluentMessageBar>
            }

            <FluentButton Appearance="ButtonAppearance.Primary"
                          Loading="IsTesting"
                          OnClick="HandleSave"
                          Class="full-width">
                Connect
            </FluentButton>
        </FluentStack>
    </FluentCard>
</FluentStack>
</div>
