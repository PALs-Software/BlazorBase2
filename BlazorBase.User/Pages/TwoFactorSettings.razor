@page "/account/two-factor"
@attribute [Authorize]

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div>
<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             Class="two-factor-container">
    <FluentCard Class="two-factor-card">
        <h2>@Localizer["PageTitle"]</h2>

        @if (IsLoading)
        {
            <FluentSpinner Size="SpinnerSize.Medium" />
        }
        else if (Status is not null)
        {
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" Title="@Localizer["Error"]" AllowDismiss="false" role="alert">
                    @ErrorMessage
                </FluentMessageBar>
            }

            @if (RecoveryCodes is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning" Title="@Localizer["RecoveryCodesTitle"]" AllowDismiss="false" role="status">
                    @Localizer["RecoveryCodesDescription"]
                </FluentMessageBar>

                <ul>
                    @foreach (var recoveryCode in RecoveryCodes)
                    {
                        <li><code>@recoveryCode</code></li>
                    }
                </ul>
            }

            @if (Status.Enabled)
            {
                <p>@Localizer["Enabled"]</p>
                <p>@string.Format(Localizer["RecoveryCodesRemaining"], Status.RecoveryCodesRemaining)</p>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-3)" Class="form-stack">
                    <FluentTextInput @bind-Value="VerificationCode"
                                     Immediate="true"
                                     Label="@Localizer["VerificationCode"]"
                                     Required="true"
                                     AutoComplete="one-time-code"
                                     Class="full-width" />
                    <p>@Localizer["VerificationCodeHint"]</p>

                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  OnClick="HandleRegenerateRecoveryCodes">
                        @Localizer["RegenerateRecoveryCodes"]
                    </FluentButton>

                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Loading="IsSubmitting"
                                  OnClick="HandleDisable">
                        @Localizer["Disable"]
                    </FluentButton>
                </FluentStack>
            }
            else
            {
                <p>@Localizer["Disabled"]</p>

                @if (!string.IsNullOrEmpty(Status.AuthenticatorUri))
                {
                    <p>@Localizer["ScanInstructions"]</p>
                    <p><code>@Status.AuthenticatorUri</code></p>
                }

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--space-3)" Class="form-stack">
                    <FluentTextInput @bind-Value="EnableCode"
                                     Immediate="true"
                                     Label="@Localizer["Code"]"
                                     Required="true"
                                     AutoComplete="one-time-code"
                                     Class="full-width" />

                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Loading="IsSubmitting"
                                  Class="full-width"
                                  OnClick="HandleEnable">
                        @Localizer["Enable"]
                    </FluentButton>
                </FluentStack>
            }
        }
    </FluentCard>
</FluentStack>
</div>
