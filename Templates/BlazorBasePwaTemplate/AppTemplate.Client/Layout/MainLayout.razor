@inherits LayoutComponentBase
@using BlazorBase.Components.Layout
@using BlazorBase.Components.Layout.Navigation

<BaseLayout AppTitle="AppTemplate">
    <HeaderContent>
        <BaseThemeToggle />
        @if (IsAuthenticated)
        {
            <span class="avatar" title="@Localizer["AvatarTitle"]">@UserInitials</span>
        }
    </HeaderContent>
    <Navigation>
        @if (IsAuthenticated)
        {
            <div class="side-nav">
                <BaseSideNavigation Items="@NavigationItems" />
            </div>
        }
    </Navigation>
    <ChildContent>
        @Body
    </ChildContent>
</BaseLayout>

@if (IsAuthenticated)
{
    <div class="bottom-nav">
        <BaseBottomNavigation Items="@NavigationItems" />
    </div>
}
