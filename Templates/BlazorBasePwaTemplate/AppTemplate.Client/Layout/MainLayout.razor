@inherits LayoutComponentBase
@using BlazorBase.Components.Layout
@using BlazorBase.Components.Layout.Navigation

<BaseLayout AppTitle="AppTemplate"
            BrandPosition="BrandPosition.Start"
            ShowCommandPalette="@IsAuthenticated"
            NavigationItems="@NavigationItems">
    <Brand>
        <AppBrand />
    </Brand>
    <HeaderContent>
        <BaseThemeToggle />
        @if (IsAuthenticated)
        {
            <span class="avatar" title="@Localizer["AvatarTitle"]">@UserInitials</span>
        }
    </HeaderContent>
    <Navigation>
        @if (IsAuthenticated)
        {
            <div class="side-nav">
                <BaseSideNavigation Items="@NavigationItems" />
            </div>
        }
    </Navigation>
    <ChildContent>
        @Body
    </ChildContent>
</BaseLayout>

