@inherits LayoutComponentBase
@using BlazorBase.Components.Layout
@using BlazorBase.Components.Layout.Navigation
@using BlazorBase.User.Components.UserMenu

<BaseLayout AppTitle="AppTemplate"
            BrandPosition="BrandPosition.Start"
            ShowCommandPalette="@IsAuthenticated"
            NavigationItems="@NavigationItems">
    <Brand>
        <AppBrand />
    </Brand>
    <HeaderContent>
        <BaseThemeToggle />
    </HeaderContent>
    <HeaderEndContent>
        @if (IsAuthenticated)
        {
            <BaseUserMenu />
        }
    </HeaderEndContent>
    <Navigation>
        @if (IsAuthenticated)
        {
            <div class="side-nav">
                <BaseSideNavigation Items="@NavigationItems" />
            </div>
        }
    </Navigation>
    <ChildContent>
        @Body
    </ChildContent>
</BaseLayout>
