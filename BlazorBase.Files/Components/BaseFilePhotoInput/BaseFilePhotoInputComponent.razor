@using BlazorBase.CRUD.Components.CustomProperties

@implements IBaseCustomPropertyInput
@implements ICardSaveParticipant

<div class="base-file-photo-input">
    @if (IsEditing && !ReadOnly)
    {
        <FluentInputFile AnchorId="@PickerButtonId"
                        Accept="@AcceptValue"
                        AdditionalAttributes="@AdditionalFileInputAttributes"
                        MaximumFileSize="@MaximumFileSizeBytes"
                        OnFileUploaded="@OnFileUploadedAsync"
                        Mode="InputFileMode.Stream">
            <ChildContent>
                <button type="button" id="@PickerButtonId" class="upload-area">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ArrowUpload())" />
                    <span>@ComponentLocalizer["SelectFile"]</span>
                </button>
            </ChildContent>
        </FluentInputFile>
    }

    @if (ShowPreview && CurrentFileId != Guid.Empty)
    {
        <div class="preview-area">
            @if (IsCurrentFileImage)
            {
                <img src="@ThumbnailUrl" alt="@ComponentLocalizer["PreviewAlt"]" class="preview-image" />
            }
            else
            {
                <span class="file-name">@ComponentLocalizer["FileSelected"]</span>
            }

            @if (IsEditing && !ReadOnly)
            {
                <FluentButton Appearance="ButtonAppearance.Transparent"
                              IconOnly="true"
                              IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Delete())"
                              OnClick="@ClearFileAsync"
                              Title="@ComponentLocalizer["RemoveFile"]" />
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert">@ValidationMessage</FluentMessageBar>
    }
</div>
