@namespace BlazorBase.Dashboard
@implements IDashboardPartHost

@{
    var partTitle = Registration.ResolveTitle(ServiceProvider);
    RenderFragment failureCard = @<div class="pf-error" role="alert">
        @if (!String.IsNullOrWhiteSpace(partTitle))
        {
            <strong class="pf-error-title">@partTitle</strong>
        }
        <p class="pf-error-text">@Localizer["PartFailed"]</p>
        <button type="button" class="pf-retry" @onclick="Retry">@Localizer["PartRetry"]</button>
    </div>;
}

<div class="pf @(IsCollapsed ? "pf--collapsed" : null) @(IsLoading ? "pf--loading" : null)" style="--pf-columns: @Registration.Columns" data-part-id="@Registration.Id" aria-busy="@(IsLoading ? "true" : null)">
    <CascadingValue TValue="IDashboardPartHost" Value="this" IsFixed="true">
        <DashboardPartErrorBoundary @key="Generation" OnFailure="OnBoundaryFailed">
            <ChildContent>
                @if (RefreshFailure is null)
                {
                    <DynamicComponent @ref="Dynamic" Type="Registration.ComponentType" />
                }
                else
                {
                    @failureCard
                }
            </ChildContent>
            <ErrorContent>
                @failureCard
            </ErrorContent>
        </DashboardPartErrorBoundary>
    </CascadingValue>
    @if (IsLoading)
    {
        <div class="pf-skeleton" aria-hidden="true">
            @if (!String.IsNullOrWhiteSpace(partTitle))
            {
                <span class="pf-skeleton-title">@partTitle</span>
            }
            else
            {
                <span class="pf-skeleton-bar pf-skeleton-bar--title"></span>
            }
            <span class="pf-skeleton-bar"></span>
            <span class="pf-skeleton-bar pf-skeleton-bar--short"></span>
        </div>
    }
</div>
