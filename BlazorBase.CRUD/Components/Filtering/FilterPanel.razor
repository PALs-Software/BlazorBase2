<div class="filter-panel-overlay" @onclick="@OnClose"></div>
<div class="filter-panel"
     role="dialog"
     aria-modal="true"
     aria-label="@Localizer["Filter"]"
     tabindex="-1"
     @ref="PanelElement"
     @onkeydown="OnKeyDownAsync">
    <div class="filter-panel-header">
        <span class="filter-panel-title">@Localizer["Filter"]</span>
        <FluentButton Appearance="ButtonAppearance.Transparent"
                      OnClick="@OnClose"
                      Title="@Localizer["FilterClose"].Value"
                      IconOnly="true"
                      IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Dismiss())" />
    </div>

    @if (SavedFilters is { IsAvailable: true })
    {
        <div class="filter-panel-saved">
            <SavedFilterMenu Saved="SavedFilters" Current="Root" OnLoad="@OnSavedFilterLoadedAsync" />
        </div>
    }

    <div class="filter-panel-body">
        @if (Fields.Count == 0)
        {
            <FluentText>@Localizer["FilterEmpty"]</FluentText>
        }
        else
        {
            <FilterGroupEditor Group="Root"
                               Fields="Fields"
                               Localizer="Localizer"
                               IsRoot="true" />
        }
    </div>

    <div class="filter-panel-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@ApplyAsync">@Localizer["FilterApply"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Transparent" OnClick="@ResetAsync">@Localizer["FilterReset"]</FluentButton>
    </div>
</div>
