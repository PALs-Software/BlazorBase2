<div class="filter-condition">
    <FluentSelect TOption="FilterOption"
                  TValue="string"
                  Items="@FieldOptions"
                  OptionValue="@(option => option?.Value)"
                  OptionText="@(option => option?.Text ?? string.Empty)"
                  Value="@(Condition.PropertyName ?? string.Empty)"
                  ValueChanged="@OnFieldChanged"
                  AriaLabel="@Localizer["FilterFieldPlaceholder"].Value"
                  Class="filter-condition-field" />

    @if (SelectedField is not null)
    {
        <FluentSelect TOption="FilterOption"
                      TValue="string"
                      Items="@OperatorOptions"
                      OptionValue="@(option => option?.Value)"
                      OptionText="@(option => option?.Text ?? string.Empty)"
                      @bind-Value="OperatorValue"
                      Class="filter-condition-operator" />
    }

    @if (ShowValueEditor)
    {
        @if (SelectedField!.Kind == FilterFieldKind.Boolean)
        {
            <FluentSelect TOption="FilterOption"
                          TValue="string"
                          Items="@BooleanOptions"
                          OptionValue="@(option => option?.Value)"
                          OptionText="@(option => option?.Text ?? string.Empty)"
                          @bind-Value="TextValue"
                          AriaLabel="@Localizer["FilterValuePlaceholder"].Value"
                          Class="filter-condition-value" />
        }
        else if (SelectedField.Kind == FilterFieldKind.Enum)
        {
            <FluentSelect TOption="FilterOption"
                          TValue="string"
                          Items="@EnumOptions"
                          OptionValue="@(option => option?.Value)"
                          OptionText="@(option => option?.Text ?? string.Empty)"
                          @bind-Value="TextValue"
                          AriaLabel="@Localizer["FilterValuePlaceholder"].Value"
                          Class="filter-condition-value" />
        }
        else if (SelectedField.Kind == FilterFieldKind.Date)
        {
            <FluentDatePicker TValue="DateTime?" @bind-Value="DateValue" Class="filter-condition-value" />
        }
        else if (SelectedField.Kind == FilterFieldKind.Number)
        {
            <FluentTextInput @bind-Value="TextValue"
                             InputMode="TextInputMode.Numeric"
                             Class="filter-condition-value"
                             Placeholder="@Localizer["FilterValuePlaceholder"].Value"
                             AriaLabel="@Localizer["FilterValuePlaceholder"].Value" />
        }
        else
        {
            <FluentTextInput @bind-Value="TextValue"
                             Class="filter-condition-value"
                             Placeholder="@Localizer["FilterValuePlaceholder"].Value"
                             AriaLabel="@Localizer["FilterValuePlaceholder"].Value" />
        }
    }

    <FluentButton Appearance="ButtonAppearance.Transparent"
                  Class="filter-condition-remove"
                  OnClick="@OnRemove"
                  Title="@Localizer["FilterRemoveCondition"].Value"
                  IconOnly="true"
                  IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" />
</div>
