@using BlazorBase.Components.Dialogs
@typeparam TModel
@inherits BaseDialogInstance

<BaseDialogBody>
    <ChildContent>
        <div class="base-lookup-search">
            <FluentTextInput @bind-Value="SearchText"
                             @bind-Value:after="OnSearchChangedAsync"
                             Class="base-lookup-field"
                             Placeholder="@FrameworkLocalizer["LookupSearchPlaceholder"].Value"
                             AriaLabel="@FrameworkLocalizer["LookupSearchPlaceholder"].Value" />
        </div>

        <div class="base-lookup-items">
            @if (IsLoading)
            {
                <FluentProgressBar />
            }
            else if (LoadedItems.Count == 0)
            {
                <FluentText>@FrameworkLocalizer["LookupNoItemsFound"]</FluentText>
            }
            else
            {
                @foreach (var item in LoadedItems)
                {
                    <div class="base-lookup-item @(item == SelectedItem ? "selected" : "")"
                         @onclick="() => SelectItem(item)">
                        <FluentText>@GetDisplayText(item)</FluentText>
                    </div>
                }

                @if (HasMoreItems)
                {
                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                  OnClick="@LoadMoreAsync">
                        @FrameworkLocalizer["LookupLoadMore"]
                    </FluentButton>
                }
            }
        </div>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      Disabled="@(SelectedItem is null)"
                      OnClick="@ConfirmSelectionAsync">
            @FrameworkLocalizer["LookupSelect"]
        </FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline"
                      OnClick="@CancelAsync">
            @FrameworkLocalizer["Cancel"]
        </FluentButton>
    </ActionTemplate>
</BaseDialogBody>
