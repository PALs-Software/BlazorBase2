@using BlazorBase.CRUD.Components.Internal
@using BlazorBase.CRUD.Configuration
@typeparam TModel

<div class="base-list @(IsMobileLayout ? "base-list-mobile" : null)">
    <CascadingValue Value="@((IColumnCollector<TModel>)this)" IsFixed="true">
        <CascadingValue Value="@((IActionGroupCollector<TModel>)this)" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </CascadingValue>

    <div class="base-list-header">
        @if (IsFilteringEnabled)
        {
            <div class="base-list-filter-group">
                <FluentButton Appearance="Appearance.Stealth"
                              Class="base-list-filter-toggle"
                              aria-label="@FilterButtonLabel"
                              OnClick="@OpenFilterPanelAsync"
                              IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Filter())">
                    @FrameworkLocalizer["Filter"]
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="base-list-filter-count" aria-hidden="true">@ActiveFilterCount</span>
                    }
                </FluentButton>
                @if (SavedFilters is not null)
                {
                    <QuickFilterMenu Saved="@SavedFilters"
                                     Current="@ActiveFilterModel"
                                     Revision="@SavedFilterRevision"
                                     OnSelect="@ApplyQuickFilterAsync" />
                }
            </div>
        }
        @if (HasRows)
        {
            <span class="base-list-count" role="status">@string.Format(FrameworkLocalizer[TotalCount == 1 ? "TotalEntry" : "TotalEntries"].Value, TotalCount)</span>
        }
        @if (ShowsSelectionColumn)
        {
            <FluentLabel Class="selection-count">@string.Format(FrameworkLocalizer["SelectedCount"].Value, SelectedItems.Count)</FluentLabel>
            <FluentButton Appearance="Appearance.Stealth"
                          OnClick="@DeselectAll"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.DismissCircle())">
                @FrameworkLocalizer["DeselectAll"]
            </FluentButton>
        }
        @if (CanAdd)
        {
            <FluentButton Appearance="Appearance.Accent"
                          OnClick="@OnAddClickedAsync"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add())">
                @(AddButtonText ?? FrameworkLocalizer["Add"].Value)
            </FluentButton>
        }
        @if (HasToolbarActions)
        {
            <BaseActionToolbar TModel="TModel"
                               ActionGroups="@ResolvedActionGroups"
                               Context="CrudActionContext.ListToolbar"
                               SelectedItems="@SelectedItems"
                               Localizer="@Localizer"
                               OnBlockedItemsChanged="@OnBlockedItemsChanged"
                               OnActionExecuted="@RefreshAsync" />
        }
    </div>

    @if (FilterPanelOpen && WorkingFilterModel is not null)
    {
        <FilterPanel Fields="@FilterFields"
                     Root="@WorkingFilterModel"
                     Localizer="@FrameworkLocalizer"
                     SavedFilters="@SavedFilters"
                     OnApply="@OnFilterApplyAsync"
                     OnReset="@OnFilterResetAsync"
                     OnClose="@CloseFilterPanel" />
    }

    @if (DeleteErrorMessage is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" Class="base-list-delete-error" role="alert" OnDismiss="@(() => DeleteErrorMessage = null)">@DeleteErrorMessage</FluentMessageBar>
    }
    @if (SelectionMessage is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" Class="base-list-delete-error" role="status" OnDismiss="@(() => SelectionMessage = null)">@SelectionMessage</FluentMessageBar>
    }
    <div class="base-list-grid" @ref="GridContainerRef"
         @onmousedown="OnMouseDown"
         @oncontextmenu="OnContextMenuAsync" @oncontextmenu:preventDefault>
        <RenderGate Key="@GridRenderKey">
        @if (IsMobileLayout)
        {
            <BaseListCardView TModel="TModel" View="@BuildMobileView()" />
        }
        else if (HasRows || IsLoading)
        {
            <FluentDataGrid @ref="DataGrid"
                            ItemsProvider="@CaptureRenderedProvider()"
                            TGridItem="TModel"
                            Virtualize="true"
                            ItemSize="48"
                            OverscanCount="10"
                            GenerateHeader="GenerateHeaderOption.Sticky"
                            OnRowClick="@OnRowClickedAsync"
                            OnRowDoubleClick="@OnRowDoubleClickedAsync"
                            OnCellClick="@OnCellClicked"
                            RowClass="@ResolveRowClass"
                            OnCellFocus="@OnCellFocusedAsync">

                @if (ShowsSelectionColumn)
                {
                    <TemplateColumn Title="" Class="base-list-select-column" Width="@SelectionColumnWidth" MinWidth="@SelectionColumnWidth">
                        <div class="select-circle @(IsSelected(context) ? "selected" : "")"
                             role="checkbox"
                             aria-checked="@(IsSelected(context) ? "true" : "false")"
                             aria-label="@(IsSelected(context) ? FrameworkLocalizer["Deselect"].Value : FrameworkLocalizer["Select"].Value)"
                             @onclick="() => ToggleSelection(context)" @onclick:stopPropagation>
                        </div>
                    </TemplateColumn>
                }

                @foreach (var column in VisibleColumnsForUser)
                {
                    if (column.Template is not null)
                    {
                        <TemplateColumn Title="@ResolveColumnHeaderName(column)"
                                        HeaderCellTitleTemplate="@HeaderTitleTemplate(column)"
                                        Tooltip="true"
                                        Width="@ResolveColumnWidth(column)"
                                        Class="@ResolveColumnClass(column)"
                                        SortBy="@(column.Sortable ? CreateSortBy(column) : null)">
                            @column.Template(context)
                        </TemplateColumn>
                    }
                    else if (ResolveCustomDisplay(column) is { } customDisplayType)
                    {
                                            <TemplateColumn Title="@ResolveColumnHeaderName(column)"
                                        HeaderCellTitleTemplate="@HeaderTitleTemplate(column)"
                                        Tooltip="true"
                                        Width="@ResolveColumnWidth(column)"
                                        Class="@ResolveColumnClass(column)"
                                        SortBy="@(column.Sortable ? CreateSortBy(column) : null)">
                            @RenderCustomDisplayCell(customDisplayType, column, context)
                        </TemplateColumn>
                    }
                    else if (column.Format is not null || IsDateTimeColumn(column))
                    {
                                            <TemplateColumn Title="@ResolveColumnHeaderName(column)"
                                        HeaderCellTitleTemplate="@HeaderTitleTemplate(column)"
                                        Tooltip="true"
                                        Width="@ResolveColumnWidth(column)"
                                        Class="@ResolveColumnClass(column)"
                                        TooltipText="@(item => ResolveCellText(column, item))"
                                        Sortable="@column.Sortable"
                                        SortBy="@(column.Sortable ? CreateSortBy(column) : null)">
                            @FormatColumnValue(column, context)
                        </TemplateColumn>
                    }
                    else if (IsBooleanColumn(column))
                    {
                                            <TemplateColumn Title="@ResolveColumnHeaderName(column)"
                                        HeaderCellTitleTemplate="@HeaderTitleTemplate(column)"
                                        Tooltip="true"
                                        Width="@ResolveColumnWidth(column)"
                                        Class="@ResolveColumnClass(column)"
                                        TooltipText="@(item => ResolveCellText(column, item))"
                                        Sortable="@column.Sortable"
                                        SortBy="@(column.Sortable ? CreateSortBy(column) : null)">
                            @BooleanColumnText(column, context)
                        </TemplateColumn>
                    }
                    else
                    {
                        <TemplateColumn Title="@ResolveColumnHeaderName(column)"
                                        HeaderCellTitleTemplate="@HeaderTitleTemplate(column)"
                                        Tooltip="true"
                                        Width="@ResolveColumnWidth(column)"
                                        Class="@ResolveColumnClass(column)"
                                        TooltipText="@(item => ResolveCellText(column, item))"
                                        Sortable="@column.Sortable"
                                        SortBy="@(column.Sortable ? CreateSortBy(column) : null)">
                            @ResolveCellText(column, context)
                        </TemplateColumn>
                    }
                }

                @if (HasContextMenuEntries)
                {
                <TemplateColumn Title="" Class="base-list-actions-column" Width="@ActionsColumnWidth" MinWidth="@ActionsColumnWidth">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Class="base-list-row-menu"
                                  Title="@FrameworkLocalizer["MoreActions"].Value"
                                  aria-label="@FrameworkLocalizer["MoreActions"].Value"
                                  aria-haspopup="menu"
                                  tabindex="-1"
                                  StopPropagation="true"
                                  IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.MoreHorizontal())"
                                  OnClick="@(e => OnRowMenuButtonClickedAsync(context, e))" />
                </TemplateColumn>
                }
            </FluentDataGrid>
        }
        </RenderGate>
    </div>
    <div class="base-list-hscroll" aria-hidden="true" tabindex="-1"><div></div></div>

    @if (ContextMenuOpen)
    {
        <div class="context-menu-overlay"
             @onclick="DismissContextMenu"
             @oncontextmenu="DismissContextMenu" @oncontextmenu:preventDefault></div>
        <nav class="context-menu @(ContextMenuPositioned ? null : "context-menu-measuring")"
             role="menu"
             tabindex="-1"
             @ref="ContextMenuElement"
             @onkeydown="OnContextMenuKeyDown"
             style="@ContextMenuStyle">
            @if (CanEdit && ContextMenuItem is not null)
            {
                <div role="menuitem" @onclick="OnContextMenuEditAsync">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Edit())" />
                    <span>@FrameworkLocalizer["Edit"]</span>
                </div>
            }
            @if (CanDelete && ContextMenuItem is not null)
            {
                <div role="menuitem" @onclick="OnContextMenuDeleteAsync">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Delete())" />
                    <span>@(SelectedItems.Count > 1 && IsSelected(ContextMenuItem) ? string.Format(FrameworkLocalizer["DeleteCount"].Value, SelectedItems.Count) : FrameworkLocalizer["Delete"].Value)</span>
                </div>
            }
            @if ((CanEdit || CanDelete) && IsSelectionAvailable && ContextMenuItem is not null)
            {
                <div class="context-menu-divider"></div>
            }
            @if (IsSelectionAvailable && ContextMenuItem is not null)
            {
                <div role="menuitem" @onclick="OnContextMenuToggleSelectAsync">
                    @if (IsSelected(ContextMenuItem))
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.DismissCircle())" />
                        <span>@FrameworkLocalizer["Deselect"]</span>
                    }
                    else
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.CheckmarkCircle())" />
                        <span>@FrameworkLocalizer["Select"]</span>
                    }
                </div>
            }
            @if (IsSelectionAvailable)
            {
            <div role="menuitem" @onclick="SelectAll">
                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.SelectAllOn())" />
                <span>@FrameworkLocalizer["SelectAll"]</span>
            </div>
            }
            @if (IsSelectionActive)
            {
                <div role="menuitem" @onclick="DeselectAll">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.SelectAllOff())" />
                    <span>@FrameworkLocalizer["DeselectAll"]</span>
                </div>
            }
            @if (ContextMenuActions is not null && ContextMenuItem is not null)
            {
                @if (HasContextMenuBaseEntries)
                {
                    <div class="context-menu-divider"></div>
                }
                <div @onclick="CloseContextMenu">
                    @ContextMenuActions(ContextMenuItem)
                </div>
            }
            @if (ContextMenuSections.Count > 0 && ContextMenuItem is not null)
            {
                var needsDivider = HasContextMenuBaseEntries || ContextMenuActions is not null;
                @foreach (var section in ContextMenuSections)
                {
                    @if (needsDivider)
                    {
                        <div class="context-menu-divider"></div>
                    }
                    needsDivider = true;
                    @foreach (var entry in section.Entries)
                    {
                        @if (entry.State.IsEnabled)
                        {
                            <div role="menuitem" @onclick="() => OnContextMenuActionClickedAsync(entry)">
                                @if (entry.Action.Icon is not null)
                                {
                                    <FluentIcon Value="@entry.Action.Icon" />
                                }
                                <span>@ResolveActionText(entry.Action.Caption)</span>
                            </div>
                        }
                        else
                        {
                            <div role="menuitem" class="context-menu-item-disabled" aria-disabled="true" title="@entry.Reason">
                                @if (entry.Action.Icon is not null)
                                {
                                    <FluentIcon Value="@entry.Action.Icon" />
                                }
                                <span>@ResolveActionText(entry.Action.Caption)</span>
                            </div>
                        }
                    }
                }
            }
        </nav>
    }

    @if (IsLoading)
    {
        <div class="base-list-loading">
            <FluentProgressRing />
        </div>
    }

    @if (!IsLoading && !HasRows)
    {
        <div class="base-list-empty">
            <FluentLabel Typo="Typography.Body">@(EmptyText ?? FrameworkLocalizer["NoItemsFound"].Value)</FluentLabel>
        </div>
    }
</div>
