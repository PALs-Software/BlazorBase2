@using System.Reflection
@using BlazorBase.CRUD.Configuration
@typeparam TModel

<div class="base-property-input @(ValidationMessages.Count > 0 ? "base-property-input-invalid" : null) @(IsReadOnlyException ? "base-property-input-readonly" : null)" id="@TooltipAnchorId" data-readonly="@(IsReadOnlyException ? "true" : null)">
    @if (FieldConfig.EditorTemplate is not null && IsEditing)
    {
        <div class="base-template-field" role="group" aria-labelledby="@LabelElementId">
            @if (ShowTemplateLabel)
            {
                <label class="base-field-label" id="@LabelElementId">@ResolvedLabel@if (IsRequired)
                {<span class="base-required-mark" aria-hidden="true">&#160;*</span>}</label>
            }
            @FieldConfig.EditorTemplate(new PropertyFieldContext<TModel>
            {
                Model = Model,
                Value = CurrentValue,
                IsEditing = true,
                Label = ResolvedLabel,
                Required = IsRequired,
                ValueChanged = EventCallback.Factory.Create<object?>(this, OnValueChangedAsync)
            })
        </div>
    }
    else if (FieldConfig.DisplayTemplate is not null && !IsEditing)
    {
        <div class="base-template-field" role="group" aria-labelledby="@LabelElementId">
            @if (ShowTemplateLabel)
            {
                <label class="base-field-label" id="@LabelElementId">@ResolvedLabel</label>
            }
            @FieldConfig.DisplayTemplate(new PropertyFieldContext<TModel>
            {
                Model = Model,
                Value = CurrentValue,
                IsEditing = false,
                Label = ResolvedLabel,
                Required = IsRequired,
                ValueChanged = EventCallback.Factory.Create<object?>(this, OnValueChangedAsync)
            })
        </div>
    }
    else if (ResolvedCustomInput is not null)
    {
        <DynamicComponent Type="ResolvedCustomInput" Parameters="@CustomInputParameters" @ref="CustomInputRef" />
    }
    else if (PropertyType == typeof(bool) || PropertyType == typeof(bool?))
    {
        <div class="base-bool-field">
            <FluentSwitch @bind-Value="BoolValue"
                          ReadOnly="@(!IsEditing)"
                          Id="@FieldElementId"
                          Label="@ResolvedLabel" />
        </div>
    }
    else if (PropertyType == typeof(DateTime) || PropertyType == typeof(DateTime?) ||
             PropertyType == typeof(DateTimeOffset) || PropertyType == typeof(DateTimeOffset?))
    {
        <FluentDatePicker @bind-Value="DateValue"
                          ReadOnly="@(!IsEditing)"
                          Required="@IsRequired"
                          Label="@ResolvedLabel" />
    }
    else if (IsNumericType)
    {
        <FluentTextField @bind-Value="NumericStringValue"
                         ReadOnly="@(!IsEditing)"
                         Label="@ResolvedLabel"
                         Placeholder="@ResolvedPlaceholder"
                         Required="@IsRequired"
                         InputMode="@NumericInputMode" />
    }
    else if (PropertyType.IsEnum)
    {
        <FluentSelect TOption="string"
                      @bind-Value="EnumStringValue"
                      Disabled="@(!IsEditing)"
                      Required="@IsRequired"
                      Label="@ResolvedLabel">
            @if (IsNullableEnum)
            {
                <FluentOption Value="">@FrameworkLocalizer["SelectEmpty"]</FluentOption>
            }
            @foreach (var enumValue in Enum.GetValues(PropertyType))
            {
                <FluentOption Value="@enumValue.ToString()">@ResolveEnumLabel(enumValue)</FluentOption>
            }
        </FluentSelect>
    }
    else if (IsNavigationProperty && !UseBrowseMode)
    {
        <FluentSelect TOption="string"
                      @key="@NavigationSelectGeneration"
                      Value="@CurrentFkStringValue"
                      ValueChanged="@OnNavigationSelectChangedAsync"
                      Disabled="@(!IsEditing)"
                      Required="@IsRequired"
                      Label="@ResolvedLabel">
            <FluentOption Value="">@FrameworkLocalizer["SelectEmpty"]</FluentOption>
            @foreach (var item in LookupItems)
            {
                <FluentOption Value="@item.Id">@item.DisplayText</FluentOption>
            }
        </FluentSelect>
    }
    else if (IsNavigationProperty && UseBrowseMode)
    {
        <div class="base-navigation-browse">
            <FluentTextField Value="@SelectedDisplayText"
                             ReadOnly="true"
                             Required="@IsRequired"
                             Label="@ResolvedLabel" />
            @if (IsEditing)
            {
                <FluentButton Appearance="Appearance.Outline"
                              OnClick="@ToggleBrowsePanel">
                    @FrameworkLocalizer["BrowsePlaceholder"]
                </FluentButton>
            }
        </div>
        @if (ShowBrowsePanel)
        {
            <div class="base-browse-panel">
                <FluentTextField @bind-Value="BrowseSearchText"
                                 @bind-Value:after="OnBrowseSearchAsync"
                                 Placeholder="@FrameworkLocalizer["BrowseSearchPlaceholder"].Value" />
                <div class="base-browse-panel-items">
                    @foreach (var item in BrowseItems)
                    {
                        <div class="base-browse-item @(item.Id == CurrentFkStringValue ? "selected" : "")"
                             @onclick="() => OnBrowseItemSelectedAsync(item)">
                            @item.DisplayText
                        </div>
                    }
                    @if (HasMoreBrowseItems)
                    {
                        <FluentButton Appearance="Appearance.Stealth"
                                      OnClick="@LoadMoreBrowseItemsAsync">
                            @FrameworkLocalizer["BrowseLoadMore"]
                        </FluentButton>
                    }
                </div>
            </div>
        }
    }
    else if (NavigationReadDenied)
    {
        <FluentTextField Value="@SelectedDisplayText"
                         ReadOnly="true"
                         Label="@ResolvedLabel" />
    }
    else if (FieldConfig.Lines > 1)
    {
        <FluentTextArea @bind-Value="StringValue"
                        ReadOnly="@(!IsEditing)"
                        Label="@ResolvedLabel"
                        Placeholder="@ResolvedPlaceholder"
                        Required="@IsRequired"
                        Rows="@FieldConfig.Lines" />
    }
    else
    {
        <FluentTextField @bind-Value="StringValue"
                         ReadOnly="@(!IsEditing)"
                         Label="@ResolvedLabel"
                         Placeholder="@ResolvedPlaceholder"
                         Required="@IsRequired" />
    }

    @if (ValidationMessages.Count > 0)
    {
        <div class="base-field-errors" id="@ErrorElementId" role="alert">
            @foreach (var message in ValidationMessages)
            {
                <div class="base-field-error">@message</div>
            }
        </div>
    }

    @if (ResolvedTooltip is not null)
    {
        <FluentTooltip Anchor="@TooltipAnchorId">@ResolvedTooltip</FluentTooltip>
    }
</div>
